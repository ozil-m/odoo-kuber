<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="capsule_service_tree" model="ir.ui.view">
            <field name="name">capsule.service.tree</field>
            <field name="model">capsule.service</field>
            <field name="arch" type="xml">
                <list string="">
                    <field name="name"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>
        <record id="capsule_service_form" model="ir.ui.view">
            <field name="name">capsule.service.form</field>
            <field name="model">capsule.service</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <!--                        <header>-->
                        <!--                            <button name="get_capsule_ids_time_slot" type="object" string="Get Time Slot"/>-->
                        <!--                        </header>-->
                        <group>
                            <field name="name"/>
                            <field name="icon"/>
                            <field name="description"/>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="price"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="capsule_service_view_action" model="ir.actions.act_window">
            <field name="name">Services Category</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">capsule.service</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>