<odoo>
    <!-- PROGRAM FORM -->
    <record id="view_lms_ffp_program_form" model="ir.ui.view">
        <field name="name">lms.ffp.program.form</field>
        <field name="model">lms.ffp.program</field>
        <field name="arch" type="xml">
            <form string="FFP Program">
                <sheet>
                    <group col="4">
                        <field name="name" required="1"/>
                        <field name="code"/>
                        <field name="logo"/>
                        <field name="business_partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- PROGRAM LIST -->
    <record id="view_lms_ffp_program_list" model="ir.ui.view">
        <field name="name">lms.ffp.program.list</field>
        <field name="model">lms.ffp.program</field>
        <field name="arch" type="xml">
            <list string="FFP Programs" decoration-muted="active == False">
                <field name="name"/>
                <field name="code"/>
                <field name="business_partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>


    <!-- PROGRAM ACTION -->
    <record id="action_lms_ffp_program" model="ir.actions.act_window">
        <field name="name">FFP Programs</field>
        <field name="res_model">lms.ffp.program</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>
