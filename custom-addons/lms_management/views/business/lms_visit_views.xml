<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========== KANBAN ========== -->
    <record id="view_lms_visit_kanban" model="ir.ui.view">
        <field name="name">lms.visit.kanban</field>
        <field name="model">lms.visit</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_group_by="state" duplicate="false">
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_card">
                            <div class="o_kanban_primary_left">
                                <div class="o_kanban_record_top">
                                    <strong>
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <span t-if="record.flight_number.raw_value">
                                            ✈️
                                            <field name="flight_number"/>
                                            —
                                            <field name="airline_id"/>
                                        </span>
                                    </div>
                                    <div>
                                        👤
                                        <field name="partner_id"/>
                                    </div>
                                    <div>
                                        🧭
                                        <field name="lounge_id"/>
                                        |
                                        <field name="branch_id"/>
                                        •
                                        <span>🧾
                                            <field name="booking_ref"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_primary_right">
                                <div class="o_kanban_tags">
                                    <span t-attf-class="badge #{record.state.raw_value}">
                                        <field name="state"/>
                                    </span>
                                    <span class="badge">
                                        <field name="invoicing_status"/>
                                    </span>
                                </div>
                                <div class="o_kanban_counter">
                                    <small>
                                        <field name="access_date"/>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ========== LIST (TREE) ========== -->
    <record id="view_lms_visit_tree" model="ir.ui.view">
        <field name="name">lms.visit.list</field>
        <field name="model">lms.visit</field>
        <field name="arch" type="xml">
            <list string="Visits" duplicate="false">
                <field name="name"/>
                <field name="access_date"/>
                <field name="lounge_id"/>
                <field name="branch_id"/>
                <field name="business_partner_id"/>
                <field name="airline_id"/>
                <field name="partner_id"/>
                <field name="access_doc_id"/>
                <field name="booking_ref"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="access_method" widget="badge"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="invoicing_status" widget="badge"
                       decoration-success="invoicing_status == 'invoiced'"
                       decoration-warning="invoicing_status == 'to_invoice'"
                       decoration-danger="invoicing_status == 'refunded'"/>
            </list>
        </field>
    </record>

    <!-- ========== FORM (TABS) ========== -->
    <record id="view_lms_visit_form" model="ir.ui.view">
        <field name="name">lms.visit.form</field>
        <field name="model">lms.visit</field>
        <field name="arch" type="xml">
            <form string="Lounge Visit" duplicate="false">
                <header>
                    <button name="action_parse_bcbp" type="object" string="Parse BCBP" invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            groups="lms_management.lms_group_supervisor"/>
                    <!-- Keep state as status bar if it's a selection with states -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>

                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_open_child_ids" icon="fa-users">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Guests</span>
                                <span class="o_stat_value">
                                    <field name="childs_count"/>
                                </span>
                            </div>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_open_voucher" icon="fa-users"
                                invisible="not voucher_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">E-Voucher</span>

                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <field name="voucher_id" invisible="1"/>
                    <!-- Top summary band -->
                    <group string="Summary">
                        <group col="2">
                            <field name="access_date"/>
                        </group>
                        <group col="2">
                            <field name="lounge_id"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- TAB: Overview -->
                        <page string="Overview">
                            <group col="2">
                                <group string="Business Partner &amp; Access">
                                    <field name="access_method"/>
                                    <field name="acceptance_rule_id" string="Cabin / Rule"
                                           invisible="access_method != 'class'"/>
                                    <field name="acceptance_rule_id" string="Tire" invisible="access_method != 'ffp'"/>
                                    <field name="acceptance_rule_id" string="Access Rule"
                                           invisible="access_method not in ['aggregator','corporate']"/>
                                    <field name="access_doc_id"/>
                                    <field name="business_partner_id"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </group>
                                <group string="Invoicing">
                                    <field name="partner_id"/>
                                    <field name="payment_method_id"/>
                                </group>
                            </group>
                        </page>

                        <!-- TAB: Flight -->
                        <page string="Boarding Details">
                            <group col="2">
                                <group string="Identity">
                                    <field name="passenger_title" string="Passenger Name"
                                           placeholder="Title / Full name on BCBP"/>
                                    <field name="first_name" string="First Name"/>
                                    <field name="last_name" string="Last Name"/>
                                    <field name="pnr" string="PNR"/>
                                </group>
                                <group string="Ticket &amp; Loyalty">
                                    <field name="ticket" string="Ticket Number"/>
                                    <field name="fqtv" string="Frequent Flyer"/>
                                </group>
                            </group>
                            <group col="4" string="Boarding Pass">
                                <field name="booking_ref" placeholder="PNR / Booking Ref"/>
                                <field name="flight_number" string="Flight Number"/>
                                <field name="flight_sequence" string="Sequence"/>
                                <field name="flight_date" string="Date"/>
                                <field name="seat_number" string="Seat"/>
                                <field name="flight_from" string="From"/>
                                <field name="flight_to" string="To"/>
                                <field name="airline_code" string="Airline Code" placeholder="e.g., SV"/>
                                <field name="airline_id" string="Airline"/>
                                <field name="class_code" string="Class Code" placeholder="J/W/Y..."/>
                            </group>
                            <group col="1">
                                <field name="boarding_pass_raw"
                                       placeholder="Paste BCBP raw string here to parse…"/>
                            </group>
                        </page>


                        <!-- TAB: Invoicing -->
                        <page string="Pricing &amp; Invoicing">
                            <group>
                                <group col="2" string="Pricing">
                                    <field name="product_id" string="Product"/>
                                    <field name="product_price" string="Product Price"/>
                                </group>
                                <group col="2" string="Invoicing">
                                    <field name="partner_id"/>
                                    <field name="payment_method_id"/>
                                    <field name="invoicing_status"/>
                                </group>
                            </group>
                        </page>


                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ========== ACTION ========== -->
    <record id="action_lms_visit" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">lms.visit</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

</odoo>
