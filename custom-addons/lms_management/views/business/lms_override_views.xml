<odoo>
    <!-- FORM -->
    <record id="view_lms_override_form" model="ir.ui.view">
        <field name="name">lms.override.form</field>
        <field name="model">lms.override</field>
        <field name="arch" type="xml">
            <form string="Supervisor Override">
                <sheet>
                    <group col="4">
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="supervisor_id" options="{'no_create': True}"/>
                            <field name="visit_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="reason" nolabel="1" placeholder="Reason for override..." colspan="2"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Passengers">
                            <field name="passenger_line_ids">
                                <list editable="bottom">
                                    <field name="passenger_name"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST -->
    <record id="view_lms_override_list" model="ir.ui.view">
        <field name="name">lms.override.list</field>
        <field name="model">lms.override</field>
        <field name="arch" type="xml">
            <list string="Overrides">
                <field name="name"/>
                <field name="supervisor_id" options="{'no_create': True}"/>
                <field name="visit_id" options="{'no_create': True}"/>
                <field name="create_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>


    <!-- ACTION -->
    <record id="action_lms_override" model="ir.actions.act_window">
        <field name="name">Overrides</field>
        <field name="res_model">lms.override</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
</odoo>
